# === VERSION CONTROL ===
.git/

# Keep our own Git config files visible in tree output
!.gitignore
!.gitmodules
!.gitattributes   # (harmless even if the file doesn't exist)

# Compiled / native-compiled Emacs Lisp
*.elc
*.eln
# *.eld - keep this - stores data like desktop configs.

# Logs and backups
*.log
init.log.bak

# LaTeX / auxiliary caches
*.cache_latex

# Tree-sitter grammars & backups
tree-sitter/
tree-sitter-backup/

# Pretty-Speedbar icons
**/pretty-speedbar-icons/

# undo-tree backup files.       
var/INFODYNAMICS/backup/

# Specific generated files
etc/images/ucd.all.flat.xml

# === GIT SUBMODULES ===
# Show directory names but ignore all contents
custom-packages/*/**
etc/INFODYNAMICS/lang-servers/*/**

# Explicitly keep the submodule directories visible
!custom-packages/*/
!etc/INFODYNAMICS/lang-servers/*/

# Package managers & their state
elpa/
**/eln-cache/
**/elpa/
**/straight/
**/gnupg/
**/gnus/
**/package/
**/dist/

# Dape debug-adapter binaries
etc/**/dape/adapters/
var/**/dape/

# Runtime state (no-littering style)
var/**/.cache_latex
var/**/anaconda-mode
var/**/auto-save
var/**/backups
var/**/elisp-autofmt/
var/**/org/persist/
var/**/recentf-save.el
var/**/savehist.el
var/**/transient/
var/**/url/
var/**/undo/
var/**/clock-persist.el
var/**/persistent-scratch.el
var/**/org/org-roam.db
var/**/image-dired/
var/**/eshell/
var/**/tramp/
var/**/dape/dape-breakpoints
var/**/bmkp/bookmark-default.el
var/INFODYNAMICS/bmkp/emacs-bmk-bmenu-state.el

# Dape bash-debug extension junk
etc/INFODYNAMICS/dape/adapters/bash-debug/extension/.github/
etc/INFODYNAMICS/dape/adapters/bash-debug/extension/bashdb_dir/
etc/INFODYNAMICS/dape/adapters/bash-debug/extension/images/
etc/INFODYNAMICS/dape/adapters/bash-debug/extension/
etc/INFODYNAMICS/dape/adapters/bash-debug/
var/INFODYNAMICS/undo-tree-hist/

var/INFODYNAMICS/bmkp/
etc/INFODYNAMICS/custom.el
var/INFODYNAMICS/auto-save-list/
etc/INFODYNAMICS/custom.el~
